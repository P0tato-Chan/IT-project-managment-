<!DOCTYPE html>
<html lang="en">
<meta charset="UTF-8"/>
<meta name = "viewport" content="width=device-width, initial-scale=1.0"/>
<link rel  = "stylesheet" href = "AutoRepairStyle.css">

<html>
<body>
   
        <h1 id = "h1">
            <%= entry.employee_id ? "Update" : "Create" %> Employee
        </h1>

        <div class = addContainer>

            <div class = "aInfo">
                <form method="post" action="/addEmployee">
                    <% if (entry.employee_id) { %>
                        <input type="hidden" name="id" value="<%= entry.employee_id %>">
                      <% } %>
                  
                      <label>First Name:</label><br>
                      <input type="text" name="firstname" value="<%= entry.employee_fname || '' %>"><br>
                  
                      <label>Last Name:</label><br>
                      <input type="text" name="lastname" value="<%= entry.employee_lname || '' %>"><br>
                  
                      <label>Address:</label><br>
                      <input type="text" name="address" value="<%= entry.address || '' %>"><br>
                  
                      <label>Mobile Phone:</label><br>
                      <input type="text" name="mobilephone" value="<%= entry.mobile || '' %>"><br>
                  
                      <label>Email:</label><br>
                      <input type="email" name="email" value="<%= entry.email || '' %>"><br>
                  
                      <label>Position:</label><br>
                      <input type="text" name="position" value="<%= entry.position || '' %>"><br>
                  
                      <label>Employment Date:</label><br>
                      <input type="date" name="employment_date" value="<%= entry.employment_date ? entry.employment_date.toISOString().split('T')[0] : '' %>"><br>
                  
                      <label>Active Status:</label><br>
                      <input type="checkbox" name="active_status" <%= entry.active_status ? "checked" : "" %>><br>
                  
                      <label>PIN Code:</label><br>
                      <input type="text" name="pincode" value="<%= entry.employee_pin || '' %>"><br><br>
                      <br>
                      <br>

                    <br>
                    <span id="aButtons">
                        <button id="aBack" onclick="goBack()">Back</button>
                        <button id="aAdd" type="submit"><%= entry.employee_id ? "Update" : "Create" %></button>
                    </span>
                </form>
            <br>

            
            </div>

        </div>
        

</body>
<script>
    function goBack() {
        window.history.back();
    }
</script>
</html>

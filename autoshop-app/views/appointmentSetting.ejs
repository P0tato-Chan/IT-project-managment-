<!DOCTYPE html>
<html lang="en">
<meta charset="UTF-8"/>
<meta name = "viewport" content="width=device-width, initial-scale=1.0"/>

<link rel = "stylesheet" href = "AutoRepairStyle.css">
<body>
    <h1 id = h1>
        Schedule Your Visit
    </h1>

    <div class = scheduler>
        <form method="post" action="/schedule">
           
            <div class = addContainer>

                <div class = "aInfo">
                <span id = aName>
                <input type = textbox id = aFirstName name="employee_fname" placeholder="First Name">
                <input type = textbox id = aLastName name="employee_lname" placeholder=" Last Name">
                </span>
                <br>
                <span id = aContact>
                    <input type = text id = aPhone name="mobile" placeholder="Phone Number">
                    <input type = email id = aEmail name="email" placeholder="e-mail">
                </span>
                <br>
                <span id = "aAddressZipState">
                    <input type = textbox id = aAddress name="address" placeholder="Address">
                    <br>
                    <input type = "date" id = "aDate" name="date">
                </span>
                <br>
    
                <span id = "carModelandYear">
                    <input type = textbox id = aMakeandModel name="model" placeholder="Model">
                    <input type = number id = aYear name = "year" placeholder=" Car Year">
                </span>
                <br>
                <span id = "aPlateNumbandService">
                    <input type = textbox id = aPlateNumb name="plate" placeholder="Plate Number">
                    <select id="aService" name="planned_repair">
                        <% services.forEach(s => { %>
                          <option value="<%= s.task_id %>" >
                            <%= s.task_name %>
                          </option>
                        <% }) %>
                      </select>


                </span>
                <br>

                <span id="aButtons">
                <button type="button" id="aBack"><a href ="/">Home</a></button>
                <button id="sSchedule">Schedule</button>
            </span>
        </div>
        </form>

</body>
</html>

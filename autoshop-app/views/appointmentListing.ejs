<!DOCTYPE html>
<html lang="en">
<meta charset="UTF-8"/>
<meta name = "viewport" content="width=device-width, initial-scale=1.0"/>
<link rel  = "stylesheet" href = "AutoRepairStyle.css">

<body>
    <html>
        <h1 id = "h1">
            Appointment Listings
        </h1>
        <form method="POST" action="/logout" style="margin-bottom: 20px;">
            <button type="submit">Logout</button>
          </form>
          <h1>Welcome, <%= user.fName %></h1>
        <div class = listContainer>
        
            <div id = "lisitingsButtons">

            <select id = "visits"> Visits
                <option value = "visits">Visits</option>

            </select>

            <span id="searchSpan">

            <input id = "searchBox" placeholder="search"></input>
            

            <select id ="custID">
               customer ID
               <option value = "custID"> customer ID </option>
            </select>

            <button id ="goButton">Go</button>

            </span>
            
            </div>

            <div class = "listingTable">
                <ul>
                    <% data.forEach(item => { %>
                      <li><%= JSON.stringify(item) %></li>
                    <% }); %>
                  </ul>
            </div>

            <button id = add> Add Listing </button>
        </div>



    </html>
</body>